# Skills de design instaladas localmente.
# .agents/ é o conteúdo; .claude/skills/ são symlinks de caminho ABSOLUTO para
# ele — num clone eles chegariam quebrados, e foi o que derrubou o upload da
# build da EAS. skills-lock.json fica versionado: é ele que diz qual skill veio
# de onde e com qual hash, então a instalação continua reproduzível.
.agents/
.claude/skills/
.impeccable/config.local.json

# Android Studio
.idea/

# Modelo cru do Z-Anatomy (155 MB): fonte, nao asset. O .glb processado
# que o app usa vive em assets/modelos/ e esse sim e versionado.
/modelo-fonte

# Export cru do Blender: 30 MB de geometria que o app NÃO embarca. Entrou em
# teste, foi recusado (MODELO-3D.md diz por quê) e fica na máquina, não no repo.
/corpo-completo.glb
